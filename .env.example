# ============================================
# Hunch — ROOT .env (API / keeper / Hardhat)
# Copy:  cp .env.example .env
# NEVER commit .env — paste keys from dashboards only
# ============================================

# ─────────────────────────────────────────────
# 1) QUICKNODE — Monad Testnet RPC (Metropolis perk)
# ─────────────────────────────────────────────
# Claim: Metropolis → Resources → Sponsor perks → Quicknode Build
# Create endpoint: chain Monad → **Testnet** (chainId 10143)
# Copy the HTTP endpoint (quiknode.pro)
MONAD_RPC_URL=https://YOUR-BUILD-ENDPOINT.monad.quiknode.pro/YOUR_TOKEN/
# Optional: same URL for phone wallet RPC
# EXPO_PUBLIC is on mobile — do not put EXPO_PUBLIC_* in this root file for Expo
BASE_RPC_URL=https://sepolia.base.org

# ─────────────────────────────────────────────
# 2) TENDERLY — simulate txs (Metropolis perk)
# ─────────────────────────────────────────────
# https://dashboard.tenderly.co → Account → Settings/Authorization → Access Keys
# Account slug = dashboard.tenderly.co/account/<SLUG>
# Project = project name in that account (e.g. hunch)
TENDERLY_ACCOUNT=your-account-slug
TENDERLY_PROJECT=hunch
TENDERLY_ACCESS_KEY=your-access-key
# Optional Tenderly Node gateway (Pro perk)
# TENDERLY_NODE_ACCESS_KEY=

# ─────────────────────────────────────────────
# 3) ZERION — wallet portfolio (Metropolis perk)
# ─────────────────────────────────────────────
# https://dashboard.zerion.io → Create API key
# HTTP Basic: username = key, password empty (server handles this)
ZERION_API_KEY=your-zerion-api-key

# ─────────────────────────────────────────────
# 4) PERPL — real trading API (Agora demo path)
# ─────────────────────────────────────────────
# https://testnet.perpl.xyz/apikeys — scope **trade**
PERPL_API_URL=https://testnet.perpl.xyz/api
PERPL_WS_URL=wss://testnet.perpl.xyz
PERPL_CHAIN_ID=10143
PERPL_API_KEY=opaque-x-api-key-token
PERPL_API_KEY_SECRET=hex-ed25519-private-key-32-bytes

# ─────────────────────────────────────────────
# 5) Pyth + hot wallet (required for keeper)
# ─────────────────────────────────────────────
PYTH_API_KEY=
PRIVATE_KEY=
# MON gas / faucet
KEEPER_MIN_MON=0.5
KEEPER_POLL_MS=10000
# ROUND_CACHE_MS=5000

# ─────────────────────────────────────────────
# Faucet caps (demo safety)
# ─────────────────────────────────────────────
# FAUCET_MAX_AUSD=1000
# FAUCET_SKIP_AUSD=250
# FAUCET_MON=0.05
# FAUCET_MON_SKIP_ABOVE=0.02
# FAUCET_COOLDOWN_MS=600000
