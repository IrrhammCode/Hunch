# ============================================
# Hunch — ROOT .env (API / keeper / Hardhat)
# Copy:  cp .env.example .env
# NEVER commit .env
# ============================================

# --- Monad RPC (required) ---
# PREFER Quicknode Build plan (Metropolis perk) — paste your endpoint:
#   https://docs.quicknode.com/docs/monad
# MONAD_RPC_URL=https://YOUR-ENDPOINT.quiknode.pro/xxxx/
# Fallback public:
MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# --- Tenderly (Metropolis perk — simulate before live tx) ---
# https://dashboard.tenderly.co → Account → Project name → Authorization / Access Keys
# TENDERLY_ACCOUNT=
# TENDERLY_PROJECT=
# TENDERLY_ACCESS_KEY=

# --- Zerion API (Metropolis perk — multi-chain portfolio) ---
# https://dashboard.zerion.io → create API key (Basic auth username; password empty)
# ZERION_API_KEY=

# --- Hot wallet (required) ---
# Hex private key for deployer / keeper / faucet / trade relay.
# WITH or WITHOUT 0x prefix is OK.
# WHERE: MetaMask → Account details → Show private key
#    OR: create a fresh throwaway wallet for testnet only
# Fund MON: https://faucet.monad.xyz
PRIVATE_KEY=

# --- Pyth Hermes (required for keeper open/resolve) ---
# WHERE: https://terminal.pyth.network → sign in → create API key → copy
PYTH_API_KEY=
# Optional Hermes base URL (default already set in code)
# HERMES_URL=https://pyth.dourolabs.app/hermes

# --- Keeper / round seed (optional) ---
# AUSD amount seeded into each new round (human units, 6 decimals)
# SEED_AUSD=1000
# LP amount when deploying vault (human units)
# VAULT_LP=50000
# Skip open/resolve if hot wallet MON below this
KEEPER_MIN_MON=0.5
# Poll interval ms (public RPC caps ~15 req/s — keep ≥8s)
KEEPER_POLL_MS=10000

# --- API server (optional) ---
# API_HOST=0.0.0.0
# API_PORT=8787
# /v1/round/current cache (ms) — reduce RPC load from phone polls
# ROUND_CACHE_MS=5000

# --- Indexer (optional — often skip for demo) ---
# INDEXER_POLL_MS=15000
# INDEXER_LOOKBACK=3
# INDEXER_LOGS=1

# --- Faucet caps (optional — defaults are safe for demo) ---
# FAUCET_MAX_AUSD=1000
# FAUCET_SKIP_AUSD=250
# FAUCET_MON=0.05
# FAUCET_MON_SKIP_ABOVE=0.02
# FAUCET_COOLDOWN_MS=600000

# --- Smoke script (optional) ---
# SMOKE_API_URL=http://localhost:8787

# --- ZeroDev / paymaster (NOT required for Metropolis demo) ---
# ZERODEV_PROJECT_ID=
# ALCHEMY_GAS_POLICY_ID=

# --- Mainnet references (docs only) ---
# AUSD_MONAD=0x00000000eFE302BEAA2b3e6e1b18d08D69a9012a
# PYTH_MONAD=0x2880aB155794e7179c9eE2e38200202908C17B43
# BTC_USD_FEED=0xe62df6c8b4a85fe1a67db44dc12de5db330f7ac66b72dc658afedf0f4a415b43
