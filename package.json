{
  "name": "hunch",
  "version": "0.1.0",
  "private": true,
  "description": "Hunch — 60-second binary hunches on Monad",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:e2e": "hardhat test test/e2e/Hunch.e2e.ts",
    "node": "hardhat node",
