# API base URL — phone cannot reach localhost.
# Local LAN (same Wi‑Fi): http://<YOUR_PC_LAN_IP>:8787
# Judge demo (public):    https://<ngrok-or-vps-host>
EXPO_PUBLIC_API_URL=http://192.168.100.4:8787

# --- Privy (required for real email OTP + embedded wallet) ---
# 1. Create an app at https://dashboard.privy.io
# 2. Enable Email OTP login
# 3. Enable Embedded wallets (Ethereum) → create on login
# 4. Add an App Client for mobile (iOS bundle id com.hunch.app) and copy its Client ID
# 5. Paste both values below (no quotes needed)
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=

# Optional: override Monad testnet RPC used by the mobile wallet
# EXPO_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Local-only demo login (SecureStore fake session). Leave unset when Privy is configured.
# EXPO_PUBLIC_USE_DEMO_AUTH=1
