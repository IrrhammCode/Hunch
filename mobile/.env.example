# ============================================
# Hunch mobile env — copy to .env and fill in
# NEVER commit .env (gitignored)
# ============================================

# --- API (required) ---
# Phone cannot reach localhost. Use LAN IP of the machine running `npm run api`.
# Local LAN:   http://192.168.x.x:8787   (check: ipconfig | findstr IPv4 on Windows)
# Public demo: https://YOUR.ngrok-free.app  (or Cloudflare tunnel / VPS)
# EXPO_PUBLIC_API_URL=http://192.168.100.4:8787
EXPO_PUBLIC_API_URL=http://192.168.100.4:8787

# --- Privy (required for real email OTP + embedded wallet) ---
# Dashboard: https://dashboard.privy.io
#
# 1. Create app → name it "Hunch"
# 2. Login methods → enable Email (OTP)
# 3. Wallets / Embedded wallets → enable Ethereum → create on login
# 4. App Clients → New client
#    - Platform: iOS (and/or Android)
#    - Bundle ID / package: com.hunch.app
#    - Copy the Client ID (starts with client_...)
# 5. Paste App ID + Client ID below (no quotes)
#
# Leave EXPO_PUBLIC_USE_DEMO_AUTH unset when using real Privy.
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=

# Optional: override Monad testnet RPC for the mobile wallet
# EXPO_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Local-only demo login (SecureStore fake session, shared hot wallet trades).
# Only for UI work without Privy. Do NOT leave this set for judge demos.
# EXPO_PUBLIC_USE_DEMO_AUTH=1
