# ============================================
# Hunch — MOBILE .env (Expo)
# Copy:  cd mobile && cp .env.example .env
# NEVER commit .env
# Restart Metro after edits (EXPO_PUBLIC_* baked at start)
# ============================================

# ── API (required) ───────────────────────────
# Phone cannot use localhost.
# LAN: http://<PC_IP>:8787
# Public demo: https://xxxx.ngrok-free.app
EXPO_PUBLIC_API_URL=http://192.168.100.3:8787

# ── Mera passkey (Agora $10k bounty) ─────────
# Host must serve AASA / assetlinks (see MERA_SETUP.md)
EXPO_PUBLIC_MERA_RP_ID=accounts.hunch.app

# ── Privy (Track 01 / secondary $5k) ─────────
# See ../PRIVY_SETUP.md — App ID + Client ID (NOT bundle id)
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=

# ── Optional: Quicknode RPC for phone wallet ─
# Same MONAD_RPC_URL as root (optional; root uses it for API/keeper)
# EXPO_PUBLIC_MONAD_RPC_URL=https://YOUR-BUILD-ENDPOINT.monad.quiknode.pro/YOUR_TOKEN/

# ── Demo auth REMOVED ────────────────────────
# There is no mock/demo login. Real path only: Mera passkey or Privy.

# ============================================
# DO NOT put here (server-only, root .env):
#   PRIVATE_KEY, PYTH_API_KEY
#   TENDERLY_ACCESS_KEY, ZERION_API_KEY
#   PERPL_API_KEY_SECRET
# Phone only needs API base + Mera rpId + Privy public IDs.
# ============================================
