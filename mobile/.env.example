# ============================================
# Hunch — MOBILE .env (Expo / Privy)
# Copy:  cd mobile && cp .env.example .env
# NEVER commit .env
# After edits: restart Metro (EXPO_PUBLIC_* baked at start)
# ============================================

# --- API URL (required on a real phone) ---
# Phone CANNOT use localhost / 127.0.0.1.
# WHERE (LAN IP on Windows):
#   PowerShell → ipconfig | findstr IPv4
#   Then: http://192.168.x.x:8787  (same Wi‑Fi as PC running `npm run api`)
# WHERE (public demo):
#   ngrok http 8787 → copy https://xxxx.ngrok-free.app
EXPO_PUBLIC_API_URL=http://192.168.100.4:8787

# --- Privy (required for real email OTP + embedded wallet) ---
# Dashboard: https://dashboard.privy.io
# Full click-path: ../PRIVY_SETUP.md
#
# EXPO_PUBLIC_PRIVY_APP_ID
#   WHERE: dashboard → your app "Hunch" → App settings / Overview → App ID → Copy
#
# EXPO_PUBLIC_PRIVY_CLIENT_ID
#   WHERE: dashboard → App clients → New client (iOS) → Bundle ID com.hunch.app
#          → Create → copy Client ID (often starts with client_)
#
# Also in dashboard (buttons to turn ON):
#   Authentication / Login methods → Email → OTP ON
#   Wallets / Embedded wallets → Ethereum → Create on login ON
#
# Leave USE_DEMO_AUTH unset for judge / Privy mode.
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=

# Optional: Monad RPC used by the phone wallet (default = official testnet)
# EXPO_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# --- Demo auth ONLY (local UI without Privy) ---
# Do NOT enable for judge demos.
# EXPO_PUBLIC_USE_DEMO_AUTH=1
